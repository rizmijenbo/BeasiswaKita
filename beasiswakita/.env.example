APP_NAME=BeasiswaKita
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (host "db" = nama service di docker-compose.yml) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=beasiswakita
DB_USERNAME=beasiswa
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Email pengingat tenggat ---
# "log" = email ditulis ke storage/logs/laravel.log (cocok untuk demo).
# Ganti ke smtp + kredensial SMTP Anda untuk pengiriman sungguhan.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="pengingat@beasiswakita.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Variabel khusus Docker Compose (tidak dipakai Laravel) ---
# Jalankan `id -u` dan `id -g` di Linux/macOS lalu samakan nilainya.
DOCKER_UID=1000
DOCKER_GID=1000
APP_PORT=8000
PMA_PORT=8080
DB_FORWARD_PORT=3307
DB_ROOT_PASSWORD=rootsecret
